MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# optional: minimal|low|medium|high|xhigh (lower = cheaper/faster; "none" is HTTP 400 on Muse Spark). Part of the replay key.
META_REASONING_EFFORT=
# mock (offline, deterministic), meta (live, records calls) or replay (from private/recordings);
# default is mock when MODEL_API_KEY is empty
MODEL_PROVIDER=
